<leaf id="0xa">
  <desc>Intel PMU (Performance Monitoring Unit)</desc>
  <text>
    This leaf is valid if @pmu_version > 0. It only enumerates the PMU resources available
    system-wide.

    Modern Intel CPUs also provide leaf 0x23, which provides a "true-view" enumeration of
    PMU resources per logical CPU, where such resources can thus differ.
  </text>
  <vendors>
    <vendor>Intel</vendor>
  </vendors>
  <subleaf id="0">
    <eax>
      <bit0  len="8"  id="pmu_version"             desc="Performance monitoring unit version ID" />
      <bit8  len="8"  id="num_counters_gp"         desc="Number of general-purpose PMU counters per logical CPU" />
      <bit16 len="8"  id="bit_width_gp"            desc="Bitwidth of PMU general-purpose counters" />
      <bit24 len="8"  id="events_mask_len"         desc="Length of CPUID(0xa).EBX bit vector" />
    </eax>
    <ebx>
      <desc>Supported PMU events, negative bitmap</desc>
      <text>
        PMU event #x is supported if EBX bit x is 0 and @events_mask_len > x.
      </text>
      <bit0  len="1"  id="no_core_cycle"           desc="Core cycle event not available" />
      <bit1  len="1"  id="no_instruction_retired"  desc="Instruction retired event not available" />
      <bit2  len="1"  id="no_reference_cycles"     desc="Reference cycles event not available" />
      <bit3  len="1"  id="no_llc_reference"        desc="LLC-reference event not available" />
      <bit4  len="1"  id="no_llc_misses"           desc="LLC-misses event not available" />
      <bit5  len="1"  id="no_br_insn_retired"      desc="Branch instruction retired event not available" />
      <bit6  len="1"  id="no_br_misses_retired"    desc="Branch mispredict retired event not available" />
      <bit7  len="1"  id="no_topdown_slots"        desc="Topdown slots event not available" />
      <bit8  len="1"  id="no_backend_bound"        desc="Topdown backend bound not available" />
      <bit9  len="1"  id="no_bad_speculation"      desc="Topdown bad speculation not available" />
      <bit10 len="1"  id="no_frontend_bound"       desc="Topdown frontend bound not available" />
      <bit11 len="1"  id="no_retiring"             desc="Topdown retiring not available" />
      <bit12 len="1"  id="no_lbr_inserts"          desc="LBR inserts not available" />
    </ebx>
    <ecx>
      <desc>Supported PMU fixed-function counters, bitmap</desc>
      <text>
        Fixed counter #x is supported if: @pmu_fcounters_bitmap[x] is 1 or
        @pmu_n_fcounters > x.
      </text>
      <bit0  len="32" id="pmu_fcounters_bitmap"    desc="Fixed-function PMU counters support bitmap" />
    </ecx>
    <edx>
      <bit0  len="5"  id="num_counters_fixed"      desc="Number of fixed PMU counters" />
      <bit5  len="8"  id="bitwidth_fixed"          desc="Bitwidth of PMU fixed counters" />
      <bit15 len="1"  id="anythread_deprecation"   desc="AnyThread mode deprecation" />
    </edx>
  </subleaf>
</leaf>
