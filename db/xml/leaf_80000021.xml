      <bit3  len="1"  id="smm_page_cfg_lock"       desc="SMM paging configuration lock" />
      <bit6  len="1"  id="null_sel_clr_base"       desc="Null selector clears base">
        <text>
          A null segment load clears the segment base.
        </text>
        <linux        feature="true"               proc="false" />
      </bit6>
      <bit7  len="1"  id="upper_addr_ignore"       desc="EFER MSR Upper Address Ignore" />
      <bit8  len="1"  id="auto_ibrs"               desc="EFER MSR Automatic IBRS">
        <text>
          EFER[AutomaticIBRSEn] bit can be set to automatically toggle IBRS protection
