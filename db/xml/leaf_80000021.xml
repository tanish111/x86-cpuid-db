<leaf id="0x80000021">
  <desc>AMD extended CPU features 2</desc>
  <vendors>
    <vendor>AMD</vendor>
  </vendors>
  <subleaf id="0">
    <eax>
      <bit0  len="1"  id="no_nested_data_bp"       desc="No nested data breakpoints">
        <linux        feature="true"               proc="false" />
      </bit0>
      <bit1  len="1"  id="fsgs_non_serializing"    desc="WRMSR to {FS,GS,KERNEL_GS}_BASE is non-serializing" />
      <bit2  len="1"  id="lfence_serializing"      desc="LFENCE always serializing / synchronizes RDTSC">
        <linux        feature="true"               proc="false"           altid="lfence_rdtsc" />
