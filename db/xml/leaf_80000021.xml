        </text>
        <linux        feature="true"               proc="false" />
      </bit16>
      <bit17 len="1"  id="user_cpuid_disable"      desc="#GP when executing CPUID at CPL > 0 is supported" />
      <bit18 len="1"  id="epsf"                    desc="Enhanced Predictive Store Forwarding" />
