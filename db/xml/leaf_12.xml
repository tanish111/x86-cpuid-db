      <bit7  len="1"  id="enclu_everifyreport2"    desc="ENCLU leaf EVERIFYREPORT2" />
      <bit10 len="1"  id="encls_eupdatesvn"        desc="ENCLS leaf EUPDATESVN" />
      <bit11 len="1"  id="enclu_edeccssa"          desc="ENCLU leaf EDECCSSA">
