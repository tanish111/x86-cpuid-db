<leaf id="0x23">
  <desc>Intel Architectural Performance Monitoring Extended (ArchPerfmonExt)</desc>
  <text>
    This leaf is valid iff cpuid leaf 0x7 @arch_perfmon_ext = 1.

    The older PMU cpuid leaf 0xa only enumerates PMU resources available system-wide.
    Conversely, this leaf provides a per-logical-CPU "true-view" enumeration of PMU
    resources.  Hence, client code should invoke it on each logical CPU as the values can
    differ between cores on hybrid Intel CPUs like Alder Lake.  Check leaf 0x1a for
    Intel's hybrid CPUs identification.

    Source: Intel Architecture Instruction Set Extensions and Future Features, March 2023.
  </text>
  <vendors>
    <vendor>Intel</vendor>
  </vendors>
  <subleaf id="0">
    <eax>
      <desc>Bitmap of valid CPUID(0x23) subleaves</desc>
      <bit0  len="1"  id="subleaf_0"               desc="Subleaf 0, this subleaf" />
      <bit1  len="1"  id="counters_subleaf"        desc="Subleaf 1, PMU counter bitmaps" />
      <bit2  len="1"  id="acr_subleaf"             desc="Subleaf 2, Auto Counter Reload bitmaps" />
      <bit3  len="1"  id="events_subleaf"          desc="Subleaf 3, PMU event bitmaps" />
      <bit4  len="1"  id="pebs_caps_subleaf"       desc="Subleaf 4, PEBS capabilities" />
      <bit5  len="1"  id="pebs_subleaf"            desc="Subleaf 5, Arch PEBS bitmaps" />
    </eax>
    <ebx>
      <bit0  len="1"  id="unitmask2"               desc="IA32_PERFEVTSELx MSRs UnitMask2 bit" />
      <bit1  len="1"  id="eq"                      desc="IA32_PERFEVTSELx MSRs EQ bit" />
    </ebx>
  </subleaf>
  <subleaf id="1">
    <eax>
      <bit0  len="32" id="gp_counters"             desc="Bitmap of general-purpose PMU counters" />
    </eax>
    <ebx>
      <bit0  len="32" id="fixed_counters"          desc="Bitmap of fixed PMU counters" />
    </ebx>
  </subleaf>
  <subleaf id="2">
    <desc>Auto Counter Reload (ACR)</desc>
    <eax>
      <bit0  len="32" id="acr_gp_reload"           desc="Bitmap of general-purpose counters that can be reloaded" />
    </eax>
    <ebx>
      <bit0  len="32" id="acr_fixed_reload"        desc="Bitmap of fixed counters that can be reloaded" />
    </ebx>
    <ecx>
      <bit0  len="32" id="acr_gp_trigger"          desc="Bitmap of general-purpose counters that can trigger reloads" />
    </ecx>
    <edx>
      <bit0  len="32" id="acr_fixed_trigger"       desc="Bitmap of fixed counters that can trigger reloads" />
    </edx>
  </subleaf>
  <subleaf id="3">
    <eax>
      <desc>True-view per logical-CPU PMU events bitmap</desc>
      <text>
        Compare this against leaf 0x10 EBX, which provides a supported PMU events bitmap,
        but against all system cores instead.
      </text>
      <bit0  len="1"  id="core_cycles_evt"         desc="Core cycles event" />
      <bit1  len="1"  id="insn_retired_evt"        desc="Instructions retired event" />
      <bit2  len="1"  id="ref_cycles_evt"          desc="Reference cycles event" />
      <bit3  len="1"  id="llc_refs_evt"            desc="Last-level cache references event" />
      <bit4  len="1"  id="llc_misses_evt"          desc="Last-level cache misses event" />
      <bit5  len="1"  id="br_insn_ret_evt"         desc="Branch instruction retired event" />
      <bit6  len="1"  id="br_mispr_evt"            desc="Branch mispredict retired event" />
      <bit7  len="1"  id="td_slots_evt"            desc="Topdown slots event" />
      <bit8  len="1"  id="td_backend_bound_evt"    desc="Topdown backend bound event" />
      <bit9  len="1"  id="td_bad_spec_evt"         desc="Topdown bad speculation event" />
      <bit10 len="1"  id="td_frontend_bound_evt"   desc="Topdown frontend bound event" />
