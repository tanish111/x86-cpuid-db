      <bit6  len="1"  id="counters_metrics"        desc="Counters group sub-group performance metrics" />
      <bit8  len="2"  id="lbr"                     desc="LBR group" />
      <bit16 len="8"  id="xer"                     desc="XER group" />
      <bit29 len="1"  id="gpr"                     desc="GPR group" />
      <bit30 len="1"  id="aux"                     desc="AUX group" />
