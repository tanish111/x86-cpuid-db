<leaf id="0x40000000">
  <desc>Maximum hypervisor standard leaf + hypervisor vendor string</desc>
  <subleaf id="0">
    <text>
      Both Intel and AMD guarantees that the cpuid leaves range 0x40000000 => 0x400000ff
      will not be used by current or future CPUs. It is a reserved range for hypervisors.
    </text>
    <hypervisors>
      <hypervisor>VMware</hypervisor>
      <hypervisor>Hyperv</hypervisor>
      <hypervisor>Xen</hypervisor>
      <hypervisor>KVM</hypervisor>
      <hypervisor>Jailhouse</hypervisor>
      <hypervisor>ACRN</hypervisor>
    </hypervisors>
    <eax>
      <bit0  len="32" id="max_hyp_leaf"            desc="Maximum hypervisor standard leaf number" />
    </eax>
    <ebx>
      <bit0  len="32" id="hypervisor_id_0"         desc="Hypervisor ID string bytes 0 - 3" />
    </ebx>
    <ecx>
      <bit0  len="32" id="hypervisor_id_1"         desc="Hypervisor ID string bytes 4 - 7" />
    </ecx>
    <edx>
      <bit0  len="32" id="hypervisor_id_2"         desc="Hypervisor ID string bytes 8 - 11" />
    </edx>
  </subleaf>
</leaf>
