<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" >

  <xs:complexType name="hypervisorType">
    <xs:attribute type="xs:string"   name="id"     use="required"/>
    <xs:attribute type="xs:string"   name="hvid"   use="required"/>
  </xs:complexType>

  <xs:complexType name="hypervisorsType">
    <xs:sequence>
      <xs:element type="hypervisorType"  name="hypervisor"
		  minOccurs="1"      maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element     type="hypervisorsType" name="hypervisors"/>
</xs:schema>
